<?xml version="1.0" encoding="utf-8"?>
<!-- Quick model / language switcher shared by the voice keyboard and the voice
     popup. Models (filled in by QuickSwitchBarHelper) and the settings button
     on the left, BG / EN on the right. The root is clickable so a tap on the
     gaps never falls through to the popup's tap-to-stop handler.
     When including, also override layout_width and layout_height, or Android
     ignores the other layout_* attributes on the <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quick_switch_bar"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/bg_quick_chip_group"
        android:paddingStart="4dp"
        android:paddingEnd="2dp"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/quick_model_chips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btn_manage_models"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quick_manage_models_desc"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_quick_chip_group"
        android:padding="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chip_lang_bg"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quick_lang_bg"
            android:contentDescription="@string/quick_lang_bg_desc"
            android:background="@drawable/bg_quick_chip"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chip_lang_en"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quick_lang_en"
            android:contentDescription="@string/quick_lang_en_desc"
            android:background="@drawable/bg_quick_chip"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
