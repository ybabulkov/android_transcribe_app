<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ime_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ime_tap_to_record"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:paddingStart="4dp"/>

        <ProgressBar
            android:id="@+id/ime_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"/>

        <!-- The button uses the status text's top and bottom gutters. Its
             margins cancel its height so the text still measures the row. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ime_history_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="-21dp"
            android:layout_marginBottom="-19dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/history_button_desc"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_history"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ime_main_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Quick model / language switcher (48dp + 8dp; the record area below is
             correspondingly 56dp shorter, so the keyboard keeps its height) -->
        <include
            layout="@layout/quick_switch_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <!-- Record area: pulsing mic-level glow behind a circular record button -->
        <FrameLayout
            android:id="@+id/ime_record_container"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:clickable="true"
            android:focusable="true">

            <dev.notune.transcribe.MicLevelView
                android:id="@+id/ime_mic_level"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center"/>

            <View
                android:id="@+id/ime_record_circle"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ime_record"/>

            <ImageView
                android:id="@+id/ime_mic_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_mic"
                android:layout_gravity="center"
                android:contentDescription="@string/section_ime"/>

            <TextView
                android:id="@+id/ime_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tap_to_record"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall"/>
        </FrameLayout>
    </LinearLayout>

    <include
        layout="@layout/ime_history_panel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone" />

    <!-- Bottom key row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/ime_switch_keyboard"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_keyboard_switch"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_switch_keyboard"/>

        <ImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_space"/>

        <ImageView
            android:id="@+id/ime_enter"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_enter"/>

        <ImageView
            android:id="@+id/ime_backspace"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ime_backspace"/>
    </LinearLayout>

</LinearLayout>
